{
  "type": "record",
  "name": "ProductDTO",
  "namespace": "net.wowdev.microservice.ecommerce.dto",
  "fields": [
    {
      "name": "id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "unitPrice",
      "type": "double",
      "doc": "The current selling price of the item."
    },
    {
      "name": "currency",
      "type": "string",
      "default": "USD",
      "doc": "The ISO 4217 currency code for the price."
    },
    {
      "name": "category",
      "type": "string"
    },
    {
      "name": "createdAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "modifiedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
