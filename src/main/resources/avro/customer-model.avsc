{
  "type": "record",
  "name": "CustomerDTO",
  "namespace": "net.wowdev.microservice.ecommerce.dto",
  "fields": [
    {
      "name": "id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "firstName",
      "type": "string"
    },
    {
      "name": "lastName",
      "type": "string"
    },
    {
      "name": "email",
      "type": "string"
    },
    {
      "name": "dateOfBirth",
      "type": [
        "null",
        {
          "type": "int",
          "logicalType": "date"
        }
      ],
      "default": null,
      "doc": "Optional date of birth stored as days since the Unix epoch."
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "CustomerStatus",
        "symbols": [
          "ACTIVE",
          "INACTIVE",
          "SUSPENDED"
        ]
      },
      "doc": "The current account lifecycle status of the customer."
    },
    {
      "name": "billingAddress",
      "type": "net.wowdev.microservice.ecommerce.dto.AddressDTO"
    },
    {
      "name": "shippingAddress",
      "type": "net.wowdev.microservice.ecommerce.dto.AddressDTO"
    },
    {
      "name": "createdAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "modifiedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
