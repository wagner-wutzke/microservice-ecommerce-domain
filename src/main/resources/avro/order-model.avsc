{
  "type": "record",
  "name": "OrderDTO",
  "namespace": "net.wowdev.microservice.ecommerce.dto",
  "fields": [
    {
      "name": "id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "OrderStatus",
        "symbols": [
          "PENDING",
          "CONFIRMED",
          "SHIPPED",
          "DELIVERED",
          "CANCELLED"
        ]
      },
      "doc": "Current lifecycle status of the order."
    },
    {
      "name": "shippingAddress",
      "type": "net.wowdev.microservice.ecommerce.dto.AddressDTO"
    },
    {
      "name": "billingAddress",
      "type": "net.wowdev.microservice.ecommerce.dto.AddressDTO"
    },
    {
      "name": "totalAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 2
      }
    },
    {
      "name": "sumAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 2
      }
    },
    {
      "name": "shippingAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 2
      }
    },
    {
      "name": "netAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 2
      }
    },
    {
      "name": "taxAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 2
      }
    },
    {
      "name": "orderNumber",
      "type": "string"
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": "net.wowdev.microservice.ecommerce.dto.OrderLineDTO"
      }
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp of order creation in milliseconds since epoch."
    },
    {
      "name": "modified_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Optional timestamp of the last status update."
    }
  ]
}
